{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://local.trivia-shorts/project.youtube.schema.json",
    "title": "Trivia Shorts YouTube Project JSON",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "platform_profile",
        "id",
        "topic",
        "title",
        "hook",
        "target",
        "voice",
        "bgm",
        "visual_strategy",
        "script",
        "youtube",
        "manual_fact_check_required"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "youtube-1.0.0"
        },
        "platform_profile": {
            "type": "string",
            "const": "youtube_shorts"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{3,64}$"
        },
        "topic": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
        },
        "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
        },
        "hook": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
        },
        "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "duration_sec",
                "aspect_ratio",
                "resolution",
                "fps",
                "video_format"
            ],
            "properties": {
                "duration_sec": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 60
                },
                "aspect_ratio": {
                    "type": "string",
                    "const": "9:16"
                },
                "resolution": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "width",
                        "height"
                    ],
                    "properties": {
                        "width": {
                            "type": "integer",
                            "const": 1080
                        },
                        "height": {
                            "type": "integer",
                            "const": 1920
                        }
                    }
                },
                "fps": {
                    "type": "integer",
                    "enum": [
                        24,
                        30,
                        60
                    ]
                },
                "video_format": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "container",
                        "video_codec",
                        "audio_codec",
                        "pix_fmt"
                    ],
                    "properties": {
                        "container": {
                            "type": "string",
                            "const": "mp4"
                        },
                        "video_codec": {
                            "type": "string",
                            "enum": [
                                "libx264",
                                "h264_nvenc"
                            ]
                        },
                        "audio_codec": {
                            "type": "string",
                            "const": "aac"
                        },
                        "pix_fmt": {
                            "type": "string",
                            "const": "yuv420p"
                        }
                    }
                }
            }
        },
        "voice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "engine",
                "speaker",
                "speed_scale",
                "pitch_scale",
                "intonation_scale",
                "sentence_gap_ms"
            ],
            "properties": {
                "engine": {
                    "type": "string",
                    "const": "aivis_speech"
                },
                "speaker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                },
                "style_id": {
                    "type": "integer",
                    "minimum": 0
                },
                "speed_scale": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2.0
                },
                "pitch_scale": {
                    "type": "number",
                    "minimum": -0.15,
                    "maximum": 0.15
                },
                "intonation_scale": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 2.0
                },
                "sentence_gap_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                }
            }
        },
        "bgm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "enabled",
                "strategy",
                "mood",
                "intensity",
                "volume_db",
                "fade_in_ms",
                "fade_out_ms",
                "allow_sources",
                "avoid"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "strategy": {
                    "type": "string",
                    "enum": [
                        "youtube_safe_bgm",
                        "local_safe_bgm",
                        "none"
                    ]
                },
                "mood": {
                    "type": "string",
                    "enum": [
                        "none",
                        "calm",
                        "light",
                        "pop",
                        "tech",
                        "minimal",
                        "mysterious",
                        "tension_low",
                        "dark",
                        "ambient"
                    ]
                },
                "intensity": {
                    "type": "string",
                    "enum": [
                        "none",
                        "low",
                        "medium"
                    ]
                },
                "volume_db": {
                    "type": "number",
                    "minimum": -40,
                    "maximum": -12
                },
                "fade_in_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3000
                },
                "fade_out_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5000
                },
                "allow_sources": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "youtube_audio_library",
                            "local_original",
                            "pixabay"
                        ]
                    }
                },
                "avoid": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "vocal",
                            "too_fast",
                            "too_loud",
                            "comic",
                            "sad",
                            "horror",
                            "copyright_risky",
                            "voice_conflict"
                        ]
                    }
                }
            }
        },
        "visual_strategy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source_priority",
                "preferred_orientation",
                "fallback",
                "primary_query",
                "fallback_queries",
                "avoid_keywords"
            ],
            "properties": {
                "source_priority": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": [
                            "pexels",
                            "local"
                        ]
                    }
                },
                "preferred_orientation": {
                    "type": "string",
                    "const": "portrait"
                },
                "fallback": {
                    "type": "string",
                    "enum": [
                        "crop_landscape_to_9_16",
                        "blur_background_with_center_crop"
                    ]
                },
                "primary_query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                },
                "fallback_queries": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 80
                    }
                },
                "avoid_keywords": {
                    "type": "array",
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 50
                    }
                }
            }
        },
        "script": {
            "type": "array",
            "minItems": 3,
            "maxItems": 18,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "index",
                    "text",
                    "visual_query",
                    "estimated_duration_sec",
                    "caption_style_hint"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "text": {
                        "type": "string",
                        "minLength": 5,
                        "maxLength": 120
                    },
                    "visual_query": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 80
                    },
                    "estimated_duration_sec": {
                        "type": "number",
                        "minimum": 1.0,
                        "maximum": 10.0
                    },
                    "caption_style_hint": {
                        "type": "string",
                        "enum": [
                            "normal",
                            "emphasis",
                            "question",
                            "punchline"
                        ]
                    }
                }
            }
        },
        "youtube": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "description",
                "hashtags",
                "tags",
                "category_hint",
                "privacy_status",
                "made_for_kids",
                "contains_synthetic_voice",
                "description_sections",
                "analytics_hypothesis"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 100
                },
                "description": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 1500
                },
                "hashtags": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^#[^\\s#]{1,30}$"
                    }
                },
                "tags": {
                    "type": "array",
                    "maxItems": 30,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                    }
                },
                "category_hint": {
                    "type": "string",
                    "enum": [
                        "education",
                        "science_and_technology",
                        "entertainment",
                        "people_and_blogs",
                        "gaming",
                        "news_and_politics"
                    ]
                },
                "privacy_status": {
                    "type": "string",
                    "enum": [
                        "private",
                        "unlisted",
                        "public"
                    ]
                },
                "made_for_kids": {
                    "type": "boolean"
                },
                "contains_synthetic_voice": {
                    "type": "boolean",
                    "const": true
                },
                "description_sections": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "summary",
                        "credits_policy",
                        "disclaimer"
                    ],
                    "properties": {
                        "summary": {
                            "type": "string",
                            "maxLength": 500
                        },
                        "credits_policy": {
                            "type": "string",
                            "enum": [
                                "include_pexels_and_bgm_credits",
                                "include_bgm_credits_only",
                                "include_pexels_credits_only",
                                "none"
                            ]
                        },
                        "disclaimer": {
                            "type": "string",
                            "maxLength": 500
                        }
                    }
                },
                "analytics_hypothesis": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "experiment_group",
                        "hypothesis",
                        "primary_metric",
                        "secondary_metrics"
                    ],
                    "properties": {
                        "experiment_group": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                        },
                        "hypothesis": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                        },
                        "primary_metric": {
                            "type": "string",
                            "enum": [
                                "views",
                                "engaged_views",
                                "average_view_percentage",
                                "average_view_duration",
                                "likes_per_view",
                                "subscribers_gained"
                            ]
                        },
                        "secondary_metrics": {
                            "type": "array",
                            "maxItems": 8,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "views",
                                    "engaged_views",
                                    "average_view_percentage",
                                    "average_view_duration",
                                    "likes",
                                    "comments",
                                    "shares",
                                    "subscribers_gained"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "manual_fact_check_required": {
            "type": "boolean",
            "const": true
        },
        "fact_check_notes": {
            "type": "string",
            "maxLength": 1000
        },
        "production_notes": {
            "type": "string",
            "maxLength": 1000
        }
    }
}
