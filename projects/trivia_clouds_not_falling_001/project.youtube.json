  "script": [
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 3.8,
      "index": 1,
      "text": "空に浮かぶ雲は、実はとても重い存在です。",
      "visual_query": "clouds sky"
    },
    {
      "caption_style_hint": "emphasis",
      "estimated_duration_sec": 4.8,
      "index": 2,
      "text": "小さな雲でも、水の重さは何十トンにもなることがあります。",
      "visual_query": "large white clouds"
    },
    {
      "caption_style_hint": "question",
      "estimated_duration_sec": 4.5,
      "index": 3,
      "text": "ではなぜ、雲はそのまま地上に落ちてこないのでしょうか。",
      "visual_query": "blue sky clouds"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 4.5,
      "index": 4,
      "text": "理由のひとつは、雲の中の水がとても小さいからです。",
      "visual_query": "water droplets macro"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 3.2,
      "index": 5,
      "text": "雲は、大きな水のかたまりではありません。",
      "visual_query": "mist fog close up"
    },
    {
      "caption_style_hint": "emphasis",
      "estimated_duration_sec": 5.5,
      "index": 6,
      "text": "目に見えないほど小さな水滴や氷の粒が、たくさん集まったものです。",
      "visual_query": "tiny water droplets"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 4.0,
      "index": 7,
      "text": "その粒は軽く、空気の流れに支えられています。",
      "visual_query": "wind clouds moving"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 4.8,
      "index": 8,
      "text": "下に落ちようとしても、上向きの空気の動きが押し返します。",
      "visual_query": "rising air clouds"
    },
    {
      "caption_style_hint": "emphasis",
      "estimated_duration_sec": 4.2,
      "index": 9,
      "text": "でも、水滴が集まって大きくなると話は変わります。",
      "visual_query": "dark rain clouds"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 3.8,
      "index": 10,
      "text": "空気では支えきれなくなり、地上へ落ちてきます。",
      "visual_query": "rain falling"
    },
    {
      "caption_style_hint": "punchline",
      "estimated_duration_sec": 1.5,
      "index": 11,
      "text": "それが、雨です。",
      "visual_query": "rain drops"
    },
    {
      "caption_style_hint": "emphasis",
      "estimated_duration_sec": 5.0,
      "index": 12,
      "text": "つまり雲は、落ちないのではなく、まだ雨になる準備中なのです。",
      "visual_query": "clouds before rain"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 5.2,
      "index": 13,
      "text": "白くふわふわ見える雲も、中では小さな水の粒が旅をしています。",
      "visual_query": "white clouds sunlight"
    },
    {
      "caption_style_hint": "normal",
      "estimated_duration_sec": 4.5,
      "index": 14,
      "text": "空を見上げたとき、その雲は未来の雨かもしれません。",
      "visual_query": "sky clouds sunset"
    },
    {
      "caption_style_hint": "punchline",
      "estimated_duration_sec": 4.0,
      "index": 15,
      "text": "雲は、空に浮かぶ水の待合室なのです。",
      "visual_query": "peaceful clouds sky"
    }
